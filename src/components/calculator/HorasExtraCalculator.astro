---
---
<div data-testid="horas-extra-calculator" class="card">

  <h2>Calculadora de horas extra</h2>
  
  <fieldset>
    <legend>Jornada y descanso</legend>
    
    <div class="form-group">
      <label for="entry-time">Hora de entrada:</label>
      <input
        id="entry-time"
        name="entryTime"
        type="text"
        pattern="[0-9]{2}:[0-9]{2}"
        inputmode="numeric"
        placeholder="08:00"
        aria-label="Hora de entrada en formato HH:MM"
      />
    </div>

    <div class="form-group">
      <label for="exit-time">Hora de salida:</label>
      <input
        id="exit-time"
        name="exitTime"
        type="text"
        pattern="[0-9]{2}:[0-9]{2}"
        inputmode="numeric"
        placeholder="18:00"
        aria-label="Hora de salida en formato HH:MM"
      />
    </div>

    <div class="form-group">
      <label for="expected-shift">Jornada prevista:</label>
      <input
        id="expected-shift"
        name="expectedShift"
        type="text"
        pattern="[0-9]{1,2}:?[0-9]{2}"
        inputmode="numeric"
        placeholder="Ej.: 8 o 08:00"
        aria-label="Jornada prevista en formato H o HH:MM"
      />
    </div>

    <div class="form-group">
      <label for="break-time">Descanso (minutos):</label>
      <input
        id="break-time"
        name="breakTime"
        type="number"
        min="0"
        step="1"
        placeholder="60"
        aria-label="Minutos de descanso"
        aria-describedby="break-help"
      />
      <span id="break-help" class="form-help">Ej: 30, 60, 90 minutos</span>
    </div>
  </fieldset>

  <div class="buttons">
    <button type="button" class="btn-primary" data-event-calculate-hours-extra="true">Calcular</button>
    <button type="button" class="btn-secondary" id="reset-btn" data-event-reset="true">Reiniciar</button>
  </div>

  <section class="results-area" aria-live="polite" aria-labelledby="result-heading">
    <h3 id="result-heading">Resultados</h3>
    <ul class="result-list" role="list"></ul>
  </section>
</div>

<style>
/* Estilos mínimos específicos del componente */
.card {
  max-width: 600px;
}
</style>

<script>import { attachHorasExtraCalculatorEvents } from '../../scripts/horasExtraCalculator';

attachHorasExtraCalculatorEvents();
</script>