---
---
<div data-testid="between-dates-calculator" class="card between-dates-calculator">

  <h2>Calculadora de tiempo entre fechas</h2>
  
  <fieldset>
    <legend>Periodo de tiempo</legend>
    
    <div class="form-group">
      <label for="date-from">Fecha inicial:</label>
      <input type="date" id="date-from" aria-label="Fecha inicial" title="Selecciona una fecha con el calendario" />
    </div>

    <div class="form-group">
      <label for="time-from">Hora inicial:</label>
      <input type="text" id="time-from" name="timeFrom" inputmode="numeric" placeholder="--:--" aria-label="Hora inicial en formato HH:MM (opcional)" title="Escribe la hora de inicio si la conoces (HH, HHHH):00" data-time-input />
    </div>

    <div class="form-group">
      <label for="date-to">Fecha final:</label>
      <input type="date" id="date-to" aria-label="Fecha final" title="Selecciona una fecha con el calendario" />
    </div>

    <div class="form-group">
      <label for="time-to">Hora final:</label>
      <input type="text" id="time-to" name="timeTo" inputmode="numeric" placeholder="--:--" aria-label="Hora final en formato HH:MM (opcional)" title="Escribe la hora de fin si la conoces (HH, HHHH):00" data-time-input />
    </div>

    <div class="form-group">
      <span class="form-help">
        Las horas son opcionales. Déjalas vacías si solo necesitas calcular entre fechas.<br/>
        Usa el calendario nativo para seleccionar más fácilmente
      </span>
    </div>
  </fieldset>

  <div class="buttons">
    <button type="button" class="btn-primary" data-event-calculate-fdates="true">Calcular</button>
    <button type="button" class="btn-secondary" id="reset-btn-betweendates" data-event-reset-fdates="true">Reiniciar</button>
  </div>

  <section class="results-area between-dates-results-area" aria-live="polite" aria-labelledby="result-heading">
    <h3 id="result-heading">Resultados</h3>
    <p class="empty-state placeholder-text">Selecciona las fechas para calcular el tiempo transcurrido.</p>
  </section>
</div>

<style>
/* Estilos mínimos específicos del componente */
.between-dates-calculator {
  max-width: 600px;
}

.between-dates-results-area {
  margin-top: var(--sp-6);
}

.time-spent-label,
.total-hours-label {
  padding: var(--sp-1) 0;
  color: var(--text);
  font-size: 1rem;
  line-height: 1.5;
}

.time-spent-label {
  border-bottom: 1px solid var(--border);
  padding-bottom: var(--sp-1);
  margin-bottom: var(--sp-1);
}

.total-hours-label {
  border-top: 1px solid var(--border);
  padding-top: var(--sp-1);
}

.empty-state {
  color: var(--text-secondary);
  font-size: 0.875rem;
  text-align: center;
  line-height: 1.6;
}

@media (max-width: 500px) {
  .between-dates-calculator {
    padding: var(--sp-4);
  }
  
  .between-dates-calculator h2 {
    font-size: 1.25rem;
  }
}
</style>

<script type="module">
import { initBetweenDatesCalculator } from '../../scripts/betweenDatesCalculator.js';

initBetweenDatesCalculator();
</script>