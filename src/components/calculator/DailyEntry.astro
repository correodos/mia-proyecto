---
---
<div data-testid="split-shift-calculator" class="card">

  <h2>Calculadora de jornada partida</h2>
  
  <fieldset class="shift-fieldset">
    <legend>Primer tramo</legend>
    
    <div class="form-row">
      <div class="form-group">
        <label for="part1-entry">Entrada</label>
        <input
          id="part1-entry"
          name="part1Entry"
          type="text"
          inputmode="numeric"
          placeholder="--:--"
          aria-label="Hora de entrada del primer tramo en formato HH:MM"
          autocomplete="off"
          maxlength="5"
        />
      </div>

      <div class="form-group">
        <label for="part1-exit">Salida</label>
        <input
          id="part1-exit"
          name="part1Exit"
          type="text"
          inputmode="numeric"
          placeholder="--:--"
          aria-label="Hora de salida del primer tramo en formato HH:MM"
          autocomplete="off"
          maxlength="5"
        />
      </div>
    </div>
  </fieldset>

  <fieldset class="shift-fieldset">
    <legend>Segundo tramo</legend>
    
    <div class="form-row">
      <div class="form-group">
        <label for="part2-entry">Entrada</label>
        <input
          id="part2-entry"
          name="part2Entry"
          type="text"
          inputmode="numeric"
          placeholder="--:--"
          aria-label="Hora de entrada del segundo tramo en formato HH:MM"
          autocomplete="off"
          maxlength="5"
        />
      </div>

      <div class="form-group">
        <label for="part2-exit">Salida</label>
        <input
          id="part2-exit"
          name="part2Exit"
          type="text"
          inputmode="numeric"
          placeholder="--:--"
          aria-label="Hora de salida del segundo tramo en formato HH:MM"
          autocomplete="off"
          maxlength="5"
        />
      </div>
    </div>
  </fieldset>

  <fieldset class="shift-fieldset">
    <legend>Descanso</legend>
    
    <div class="form-group">
      <label for="break-time">Descanso entre turnos</label>
      <input
        id="break-time"
        name="breakTime"
        type="text"
        value=""
        readonly
        aria-label="Descanso automático calculado (solo lectura)"
      />
    </div>
  </fieldset>

  <div class="buttons">
    <button type="button" class="btn-primary" data-event-calculate-split-shift="true">Calcular</button>
    <button type="button" class="btn-secondary" id="reset-btn-split-shift" data-event-reset-split-shift="true">Reiniciar</button>
  </div>

  <section class="results-area split-results" aria-live="polite" aria-labelledby="result-heading">
    <h3 id="result-heading">Resultados</h3>
    <ul class="result-list" role="list"></ul>
  </section>
</div>

<style>
/* Estilos específicos del componente (no en global.css) */
.shift-fieldset {
  border: none;
  padding: 0;
  margin-bottom: var(--sp-4);
}

.shift-fieldset legend {
  font-weight: 600;
  font-size: 1rem;
  color: var(--text);
  margin-bottom: var(--sp-3);
  padding-bottom: var(--sp-2);
  border-bottom: 2px solid var(--border);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-4);
  margin-bottom: var(--sp-2);
}

.form-row .form-group:last-child {
  margin-bottom: 0;
}

#break-time {
  background-color: var(--bg-muted);
  color: var(--text-secondary);
  text-align: center;
}

@media (max-width: 640px) {
  .form-row {
    grid-template-columns: 1fr;
    gap: var(--sp-2);
  }
}
</style>

<script type="module">
import { initSplitShiftCalculator } from '../../scripts/splitShiftCalculator.js';

initSplitShiftCalculator();
</script>