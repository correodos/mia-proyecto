<div data-testid="weekly-calculator" class="card weekly-calculator">

  <h2>Calculadora semanal de horas</h2>

  <!-- Lunes -->
  <fieldset class="day-section">
    <legend class="day-legend lunes"><span>Lunes</span></legend>
    
    <div class="form-group">
      <label for="lun-entry">Entrada:</label>
      <input id="lun-entry" name="weeklyEntry[0]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="lun-exit">Salida:</label>
      <input id="lun-exit" name="weeklyExit[0]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>
    
    <div class="form-group">
      <label for="lun-break">Descanso (min, opcional):</label>
      <input id="lun-break" name="weeklyBreak[0]" type="number" min="0" max="480">
      <span id="lun-break-help" class="form-help">Deja vacío para 0 min o pon: 30, 60 minutos</span>
    </div>
  </fieldset>

  <!-- Martes -->
  <fieldset class="day-section">
    <legend class="day-legend martes"><span>Martes</span></legend>
    
    <div class="form-group">
      <label for="mar-entry">Entrada:</label>
      <input id="mar-entry" name="weeklyEntry[1]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="mar-exit">Salida:</label>
      <input id="mar-exit" name="weeklyExit[1]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="mar-break">Descanso (min, opcional):</label>
      <input id="mar-break" name="weeklyBreak[1]" type="number" min="0" max="480">
      <span id="mar-break-help" class="form-help">Deja vacío para 0 min o pon: 30, 60 minutos</span>
    </div>
  </fieldset>

  <!-- Miércoles -->
  <fieldset class="day-section">
    <legend class="day-legend miércoles"><span>Miércoles</span></legend>
    
    <div class="form-group">
      <label for="mie-entry">Entrada:</label>
      <input id="mie-entry" name="weeklyEntry[2]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="mie-exit">Salida:</label>
      <input id="mie-exit" name="weeklyExit[2]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="mie-break">Descanso (min, opcional):</label>
      <input id="mie-break" name="weeklyBreak[2]" type="number" min="0" max="480">
      <span id="mie-break-help" class="form-help">Deja vacío para 0 min o pon: 30, 60 minutos</span>
    </div>
  </fieldset>

  <!-- Jueves -->
  <fieldset class="day-section">
    <legend class="day-legend jueves"><span>Jueves</span></legend>
    
    <div class="form-group">
      <label for="jue-entry">Entrada:</label>
      <input id="jue-entry" name="weeklyEntry[3]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="jue-exit">Salida:</label>
      <input id="jue-exit" name="weeklyExit[3]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="jue-break">Descanso (min, opcional):</label>
      <input id="jue-break" name="weeklyBreak[3]" type="number" min="0" max="480">
      <span id="jue-break-help" class="form-help">Deja vacío para 0 min o pon: 30, 60 minutos</span>
    </div>
  </fieldset>

  <!-- Viernes -->
  <fieldset class="day-section">
    <legend class="day-legend viernes"><span>Viernes</span></legend>
    
    <div class="form-group">
      <label for="vie-entry">Entrada:</label>
      <input id="vie-entry" name="weeklyEntry[4]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="vie-exit">Salida:</label>
      <input id="vie-exit" name="weeklyExit[4]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="vie-break">Descanso (min, opcional):</label>
      <input id="vie-break" name="weeklyBreak[4]" type="number" min="0" max="480">
      <span id="vie-break-help" class="form-help">Deja vacío para 0 min o pon: 30, 60 minutos</span>
    </div>
  </fieldset>

  <!-- Sábado -->
  <fieldset class="day-section">
    <legend class="day-legend sábado"><span>Sábado</span></legend>
    
    <div class="form-group">
      <label for="sab-entry">Entrada:</label>
      <input id="sab-entry" name="weeklyEntry[5]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="sab-exit">Salida:</label>
      <input id="sab-exit" name="weeklyExit[5]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="sab-break">Descanso (min, opcional):</label>
      <input id="sab-break" name="weeklyBreak[5]" type="number" min="0" max="480">
      <span id="sab-break-help" class="form-help">Deja vacío para 0 min o pon: 30, 60 minutos</span>
    </div>
  </fieldset>

  <!-- Domingo -->
  <fieldset class="day-section">
    <legend class="day-legend domingo"><span>Domingo</span></legend>
    
    <div class="form-group">
      <label for="dom-entry">Entrada:</label>
      <input id="dom-entry" name="weeklyEntry[6]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="dom-exit">Salida:</label>
      <input id="dom-exit" name="weeklyExit[6]" type="text" pattern="[0-9]{2}:[0-9]{2}" inputmode="numeric" placeholder="--:--">
    </div>

    <div class="form-group">
      <label for="dom-break">Descanso (min, opcional):</label>
      <input id="dom-break" name="weeklyBreak[6]" type="number" min="0" max="480">
      <span id="dom-break-help" class="form-help">Deja vacío para 0 min o pon: 30, 60 minutos</span>
    </div>
  </fieldset>

  <!-- Botones -->
  <div class="buttons">
    <button id="calculate-weekly-btn" type="button" class="btn-primary">Calcular</button>
    <button id="reset-weekly-btn" type="button" class="btn-secondary">Reiniciar</button>
  </div>
  
  <!-- Resultados -->
  <section id="results-area" class="results-area" aria-live="polite" aria-labelledby="result-heading">
    <h3 id="result-heading">Resultados</h3>
    <ul class="result-list" role="list"></ul>
  </section>

</div>

<style>
/* Estilos específicos del componente weekly-calculator (no en global.css) */
.weekly-calculator {
  max-width: 100%;
  overflow-x: auto;
}

.day-section {
  background-color: var(--bg);
  border: none;
  border-radius: 0;
  padding: 0;
  margin-bottom: var(--sp-2);
}

.day-section > .form-group:last-child {
  margin-bottom: 0;
}

.form-group {
  margin-bottom: var(--sp-1);
  padding: 0;
}

.day-legend {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  font-size: 1.1rem;
  text-align: left;
  padding-bottom: var(--sp-2);
  margin-bottom: var(--sp-1);
  border-bottom: 3px solid currentColor;
  position: relative;
  transition: all var(--t-base);
}

.day-legend::before {
  content: '';
  display: block;
  width: 24px;
  height: 3px;
  background-color: currentColor;
  border-radius: 2px;
  opacity: 0.8;
}

/* Colores por día */
.day-legend.lunes { color: #ef4444; }
.day-legend.martes { color: #f97316; }
.day-legend.miércoles { color: #22c55e; }
.day-legend.jueves { color: #3b82f6; }
.day-legend.viernes { color: #a855f7; }
.day-legend.sábado { color: #ec4899; }
.day-legend.domingo { color: #1e293b; font-weight: 800; }

label {
  display: block;
  font-weight: 500;
  color: var(--text);
  margin-bottom: var(--sp-1);
  font-size: 0.875rem;
}

input[type="text"],
input[type="number"] {
  font-size: inherit;
  line-height: inherit;
  width: 140px;
  padding: var(--sp-2) var(--sp-2);
  border: 1.5px solid var(--input-border);
  border-radius: var(--radius);
  background-color: var(--input-bg);
  box-sizing: border-box;
  min-height: 44px;
}

input[type="text"]::placeholder,
input[type"]number"]::placeholder {
  color: var(--text-muted);
}

#results-area {
  margin-top: var(--sp-6);
  padding: var(--sp-4);
  max-width: none;
}

/* Layout responsivo para tablet y desktop */
@media (min-width: 768px) {
  .weekly-calculator {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
    max-width: 900px;
    margin: 0 auto;
  }

  .weekly-calculator h2 {
    grid-column: 1 / -1;
  }

  #results-area {
    grid-column: 1 / -1;
    width: 100%;
  }
}

@media (min-width: 1024px) {
  .weekly-calculator {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* Layout columna única para móvil estrecho */
@media (max-width: 767px) {
  .weekly-calculator {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .weekly-calculator h2 {
    font-size: 1.3rem;
  }

  .day-legend {
    font-size: 0.9rem;
  }

  .form-group {
    margin-bottom: var(--sp-1);
  }

  label {
    font-size: 0.8rem;
  }

  input[type="text"],
  input[type="number"] {
    width: max-content;
    min-width: 120px;
    padding: var(--sp-2);
  }

  .buttons {
    flex-direction: column;
    gap: var(--sp-1);
    margin-top: var(--sp-4);
  }

  .buttons button {
    width: 100%;
    max-width: none;
    min-width: auto;
  }
}

/* Ajustes mínimos para móviles muy estrechos (menor que 375px) */
@media (max-width: 374px) {
  .weekly-calculator {
    padding: var(--sp-2);
  }

  .weekly-calculator h2 {
    font-size: 1.1rem;
  }

  .day-legend {
    font-size: 0.85rem;
  }

  label {
    font-size: 0.75rem;
  }

  input[type="text"],
  input[type="number"] {
    min-width: 100px;
    padding: var(--sp-1);
  }
}
</style>

<script type="module">
import { initWeeklyCalculator } from '../../scripts/weeklyCalculator.js';

initWeeklyCalculator();
</script>