---
interface Props {
  title: string;
  desc: string;
  href: string;
  icon: string;
  badge: 'Calculadora' | 'Guía';
}

const { title, desc, href, icon, badge } = Astro.props;
---

<a href={href} class={`tool-card ${badge.toLowerCase()}`} data-type={badge.toLowerCase()}>
  <span class={`tool-badge ${badge.toLowerCase()}`}>{badge}</span>
  <span class="tool-icon" aria-hidden="true">{icon}</span>
  <h3>{title}</h3>
  <p>{desc}</p>
</a>

<style>
  .tool-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    transition: border-color var(--t-base), box-shadow var(--t-base), transform var(--t-base);
  }

  .tool-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tool-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9999px;
    margin-bottom: var(--sp-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tool-badge.calculadora {
    background: var(--primary-light);
    color: var(--primary);
  }

  .tool-badge.guía {
    background: var(--success-bg);
    color: var(--success);
  }

  .tool-icon {
    font-size: 1.5rem;
    margin-bottom: var(--sp-2);
    display: block;
    line-height: 1;
  }

  .tool-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--sp-2);
    color: var(--text);
  }

  .tool-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }
</style>