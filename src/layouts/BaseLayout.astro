---
import '../styles/global.css';
import MobileMenu from '../components/layout/MobileMenu.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="MiA - Herramientas de tiempo" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
    <title>{title}</title>
  </head>

  <body>

    <!-- HEADER -->
    <header role="banner" aria-label="Encabezado principal" class="main-header">
      <div class="header-inner">

        <!-- Branding -->
        <a href={import.meta.env.BASE_URL} class="brand-link" aria-label="MiA - Inicio">
          <span class="brand-text">MiA</span>
          <span class="brand-subtitle">Herramientas de tiempo</span>
        </a>

        <!-- Navegación desktop -->
        <nav class="main-nav" role="navigation" aria-label="Navegación principal">
          <ul>
            <li><a href={import.meta.env.BASE_URL + "calculadora-horas/"} class="nav-link">Horas trabajadas</a></li>
            <li><a href={import.meta.env.BASE_URL + "calculadora-semanal-horas/"} class="nav-link">Semanal</a></li>
            <li><a href={import.meta.env.BASE_URL + "calculadora-horas-extra/"} class="nav-link">Horas extra</a></li>
            <li><a href={import.meta.env.BASE_URL + "calculadora-jornada-partida/"} class="nav-link">Jornada partida</a></li>
            <li><a href={import.meta.env.BASE_URL + "calculadora-entre-fechas/"} class="nav-link">Entre fechas</a></li>
          </ul>
        </nav>

        <!-- Botón hamburguesa (móvil) -->
        <button
          type="button"
          class="mobile-menu-toggle"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
          aria-label="Abrir menú de navegación"
        >
          <span aria-hidden="true" id="menu-icon">☰</span>
        </button>

      </div>

      <!-- Menú móvil (oculto por defecto) -->
      <MobileMenu />
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-container">
      <slot />
    </div>

    <!-- FOOTER -->
    <footer role="contentinfo" class="main-footer">
      <div class="footer-inner">
        <p>&copy; <time id="year"></time> MiA — Herramientas gratuitas para calcular horas de trabajo.</p>
      </div>
    </footer>

    <script is:inline>
      // Año en footer
      const yearEl = document.getElementById('year');
      if (yearEl) yearEl.textContent = String(new Date().getFullYear());
    </script>

  </body>
</html>