---
/**
 * Página 404 - No encontrada
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Página no encontrada - MiA Herramientas de tiempo';
const description = 'La página que buscas no ha podido ser encontrada. Vuelve al inicio para usar nuestras calculadoras gratuitas.';
const canonical = import.meta.env.BASE_URL;
---

<BaseLayout 
  title={title}
  description={description}
  canonical={canonical}
  skipWebPage={true}
>
<main role="main">
  <section class="container" aria-labelledby="not-found-heading">
    <article>
      <h1 id="not-found-heading">Página no encontrada</h1>
      
      <p class="intro-text">
        La página que buscas no existe, ha sido movida o eliminada. 
        Vuelve al inicio o accede directamente a la calculadora de horas trabajadas.
      </p>

      <nav aria-labelledby="navegacion-404" role="navigation">
        <h2 id="navegacion-404">Navegación</h2>
        <ul role="list">
          <li>
            <a href={import.meta.env.BASE_URL}>Ir al inicio</a>
          </li>
          <li>
            <a href={import.meta.env.BASE_URL + "calculadora-horas/"}>Calculadora de horas trabajadas</a>
          </li>
          <li>
            <a href={import.meta.env.BASE_URL + "calculadora-semanal-horas/"}>Calculadora semanal de horas</a>
          </li>
        </ul>
      </nav>
    </article>
  </section>
</main>

<meta name="robots" content="noindex, follow" />
</BaseLayout>

<style lang="css" is:global>
.container {
  max-width: min(100% - 2rem, 800px);
  margin: 0 auto;
  padding: var(--sp-8) var(--sp-4);
  text-align: center;
}

.intro-text {
  font-size: 1.125rem;
  color: var(--text-secondary);
  margin-bottom: var(--sp-8);
  line-height: 1.6;
}

nav ul {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  align-items: center;
}

nav a {
  color: var(--primary);
  text-decoration: underline;
  font-weight: 500;
  font-size: 1rem;
  transition: color var(--t-fast);
}

nav a:hover {
  color: var(--primary-hover);
}

@media (max-width: 600px) {
  .container {
    padding: var(--sp-6) var(--sp-3);
  }
  
  h1 {
    font-size: 1.75rem;
  }
}
</style>