---
/**
 * Página 404 - No encontrada
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Página no encontrada - MiA Herramientas de tiempo';
const description = 'La página que buscas no ha podido ser encontrada. Vuelve al inicio para usar nuestras calculadoras gratuitas.';
const canonical = `${import.meta.env.BASE_URL}404`;
---

<BaseLayout 
  title={title}
  description={description}
  canonical={canonical}
>
<header role="banner">
  <nav role="navigation" aria-label="Principal">
    <a href={import.meta.env.BASE_URL} aria-label="Ir al inicio" class="header-link">MiA - Herramientas de tiempo</a>
  </nav>
</header>

<main role="main">
  <section class="container" aria-labelledby="not-found-heading">
    <article>
      <h1 id="not-found-heading">Página no encontrada</h1>
      
      <p class="intro-text">
        La página que buscas no existe, ha sido movida o eliminada. 
        Vuelve al inicio o accede directamente a la calculadora de horas trabajadas.
      </p>

      <nav aria-labelledby="navegacion-404" role="navigation">
        <h2 id="navegacion-404">Navegación</h2>
        <ul role="list">
          <li>
            <a href={import.meta.env.BASE_URL}>Ir al inicio</a>
          </li>
          <li>
            <a href={import.meta.env.BASE_URL + "calculadora-semanal-horas/"}>Calculadora semanal de horas</a>
          </li>
          <li>
            <a href={import.meta.env.BASE_URL + "calculadora-horas/"}>Calculadora de horas trabajadas</a>
          </li>
        </ul>
      </nav>
    </article>
  </section>
</main>

<footer role="contentinfo">
  <p>Herramientas gratuitas para organizar y calcular horas de trabajo</p>
</footer>
</BaseLayout>

<meta name="robots" content="noindex, follow" /> 

<style lang="css">
:root {
  --primary: #3b82f6;
  --text: #1f2937;
  --bg: #ffffff;
}

.container {
  max-width: min(100% - 2rem, 800px);
  margin: 0 auto;
  font-family: system-ui, -apple-system, sans-serif;
  color: var(--text);
  background-color: var(--bg);
}

p {
  margin-bottom: 1rem;
}

details {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

summary {
  cursor: pointer;
  padding: 0.5rem;
  font-weight: 600;
}

details[open] summary {
  margin-bottom: 0.5rem;
}

h2, h3 {
  margin-top: 1.5rem;
}

hr {
  border: none;
  border-top: 1px solid #e5e7eb;
  margin: 2rem 0;
}

a {
  color: var(--primary);
}

kbd {
  background-color: #f3f4f6;
  padding: 0.125rem 0.375rem;
  border-radius: 4px;
  font-family: monospace;
  border: 1px solid #e5e7eb;
}

@media (max-width: 600px) {
  .container {
    padding: 0.5rem;
  }
  
  h1 {
    font-size: 1.5rem;
  }
}
</style>

<title>{title}</title>
