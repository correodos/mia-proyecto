---
import BetweenDatesCalculator from '../../components/calculator/BetweenDatesCalculator.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollapsibleExamples from '../../components/CollapsibleExamples.astro';

const pageData = {
  title: "Calculadora Entre Fechas",
  description: "Calculadora gratuita entre fechas. Calcula dias, horas y minutos entre dos fechas con horas opcionales.",
  canonical: "https://mia-proyecto.pages.dev/calculadora-entre-fechas/"
};

const { title, description, canonical } = pageData;
---

<BaseLayout 
  title={title}
  description={description}
  canonical={canonical}
>
<main role="main">
  <h1>Calculadora de tiempo entre dos fechas | Diferencia exacta con horas</h1>
  
  <section class="intro-section">
    <p class="intro-text">
      Calcula días, horas y minutos entre dos fechas (con horas opcionales). Útil para vacaciones, plazos y periodos.
    </p>
  </section>
  
  <BetweenDatesCalculator />

  <section aria-labelledby="how-to-heading" class="content-section">
    <h2 id="how-to-heading">Cómo calcular el tiempo entre fechas paso a paso</h2>
    
    <ol class="steps">
      <li>Selecciona la fecha inicial (con hora opcional).</li>
      <li>Selecciona la fecha final (con hora opcional).</li>
      <li>Pulsa "Calcular" para ver días, horas y minutos exactos.</li>
    </ol>
  </section>

  <section aria-labelledby="examples-heading" class="content-section">
    <CollapsibleExamples
      title="Ejemplos prácticos"
      examples={[
        {
          summary: 'Con horas: 21/09/2026 07:00 → 23/09/2026 17:30',
          content: '<p><strong>Tiempo transcurrido:</strong> 2 días, 8 horas y 30 minutos<br><small>Total: 56,50 horas</small></p>',
        },
        {
          summary: 'Solo fechas (sin horas): 21/09/2026 → 23/09/2026',
          content: '<p><strong>Tiempo transcurrido:</strong> 2 días, 0h 00 minutos<br><small>Total: 48,00 horas</small></p>',
        },
        {
          summary: 'Cruce de año: 31/12/2026 23:00 → 01/01/2027 02:00',
          content: '<p><strong>Tiempo transcurrido:</strong> 1 día, 3 horas<br><small>Total: 27,00 horas</small></p>',
        },
      ]}
    />
  </section>

  <section aria-labelledby="faq-heading" class="content-section">
    <CollapsibleExamples
      title="Preguntas frecuentes"
      examples={[
        {
          summary: '¿Cómo calcular el tiempo transcurrido entre dos fechas?',
          content: '<p>La calculadora resta automáticamente la fecha inicial de la final. Si especificas las horas, obtendrás el resultado exacto expresado en días, horas y minutos. Es ideal para calcular diferencias precisas entre cualquier periodo temporal.</p>',
        },
        {
          summary: '¿Debo escribir obligatoriamente las horas?',
          content: '<p>No es obligatorio. Puedes dejar los campos de hora vacíos si solo necesitas calcular cuántos días pasaron entre un día y otro, sin precisar la hora exacta.</p>',
        },
        {
          summary: '¿Funciona para periodos que cruzan meses o años?',
          content: '<p>Sí, calcula perfectamente el tiempo entre fechas cuando cambias de mes (por ejemplo del 28 de febrero al 1 de marzo), cruces un año completo (31/12 → 01/01) e incluso grandes diferencias temporales dentro de los límites de JavaScript.</p>',
        },
      ]}
    />
  </section>

  <section aria-labelledby="other-tools-heading" class="tools-list">
    <h2 id="other-tools-heading">Otras herramientas relacionadas con horas y tiempo</h2>
    
    <nav role="navigation" aria-label="Otras herramientas">
      <ul role="list">
        <li>
          <a href={import.meta.env.BASE_URL + "calculadora-horas/"}>
            <article>
              <h3>Calculadora de horas trabajadas</h3>
              <p>Calcula el tiempo trabajado con entrada, salida y descansos.</p>
            </article>
          </a>
        </li>
        
        <li>
          <a href={import.meta.env.BASE_URL + "calculadora-semanal-horas/"}>
            <article>
              <h3>Calculadora semanal</h3>
              <p>Suma las horas de varias jornadas laborables de la semana.</p>
            </article>
          </a>
        </li>
        
        <li>
          <a href={import.meta.env.BASE_URL + "calculadora-horas-extra/"}>
            <article>
              <h3>Calculadora de horas extra</h3>
              <p>Detecta automáticamente las horas adicionales sobre tu jornada normal.</p>
            </article>
          </a>
        </li>
      </ul>
    </nav>
  </section>

  <footer role="contentinfo">
    <p>Herramienta gratuita para calcular el tiempo entre dos fechas y horas</p>
  </footer>
</main>
</BaseLayout>