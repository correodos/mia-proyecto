---
import HorasExtraCalculator from '../../components/calculator/HorasExtraCalculator.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollapsibleExamples from '../../components/CollapsibleExamples.astro';

const pageData = {
  title: "Calculadora de Horas Extra",
  description: "Calculadora gratuita de horas extra. Calcula horas trabajadas y detecta horas extra respecto a tu jornada prevista.",
  canonical: "https://miaherramienta.com/calculadora-horas-extra/"
};

const { title, description, canonical } = pageData;
---

<BaseLayout 
  title={title}
  description={description}
  canonical={canonical}
>
<main role="main">
  <h1>Calculadora de horas extra</h1>
  
  <section class="intro-section">
    <p class="intro-text">
      Calcula horas trabajadas y detecta horas extra respecto a tu jornada prevista. Incluye turnos nocturnos y descansos.
    </p>
  </section>

  <HorasExtraCalculator />

  <section aria-labelledby="how-to-heading" class="content-section">
    <h2 id="how-to-heading">Cómo usarla</h2>
    
    <p>Introduce los datos de tu jornada:</p>
    
    <div class="alert alert-info">
      <strong>1. Entrada y salida:</strong> hora de inicio y fin de tu turno (ej: 08:00 / 18:00).
    </div>
    <div class="alert alert-info">
      <strong>2. Jornada prevista y descanso:</strong> horas que debes trabajar y minutos de pausa (ej: 08:00 / 60).
    </div>
    <div class="alert alert-info">
      <strong>3. Pulsa <kbd>Calcular</kbd></strong> para ver horas trabajadas y horas extra.
    </div>
    
    <p>Usa <kbd>Reiniciar</kbd> para limpiar los campos.</p>
  </section>

  <section aria-labelledby="examples-heading" class="content-section">
    <CollapsibleExamples
      title="Ejemplos"
      examples={[
        {
          summary: 'Sin horas extra: 08:00 → 16:00, descanso 30 min, prevista 8 h',
          content: '<p><strong>Trabajadas:</strong> 7:30 | <strong>Extra:</strong> 0 h (jornada no completada)</p>',
        },
        {
          summary: 'Con horas extra: 08:00 → 18:30, descanso 60 min, prevista 8 h',
          content: '<p><strong>Trabajadas:</strong> 9:30 | <strong>Extra:</strong> 1:30 (1,50 h)</p>',
        },
        {
          summary: 'Nocturna con extra: 22:00 → 07:30, descanso 60 min, prevista 8 h',
          content: '<p><strong>Trabajadas:</strong> 8:30 | <strong>Extra:</strong> 0:30 (0,50 h)</p>',
        },
      ]}
    />
  </section>

  <section aria-labelledby="faq-heading" class="content-section">
    <CollapsibleExamples
      title="Preguntas frecuentes"
      examples={[
        {
          summary: '¿La calculadora funciona si trabajo toda la noche?',
          content: '<p>Sí. Puedes introducir una entrada (ej: 22:00) y salida anterior (ej: 06:00), lo que indica que la jornada cruza la medianoche.</p>',
        },
        {
          summary: '¿Puedo no poner descanso?',
          content: '<p>Sí. Puedes dejar el campo vacío o poner 00:00 si no has tenido pausa.</p>',
        },
        {
          summary: '¿Qué significa "horas extra"?',
          content: '<p>Las horas extra son el tiempo trabajado que supera la jornada prevista. Si trabajaste 9 horas y tu jornada era de 8, tienes 1 hora extra.</p>',
        },
      ]}
    />
  </section>

  <section aria-labelledby="other-tools-heading" class="tools-list">
    <h2 id="other-tools-heading">Otras herramientas</h2>
    
    <nav role="navigation" aria-label="Otras herramientas">
      <ul role="list">
        <li>
          <a href={import.meta.env.BASE_URL + "calculadora-horas/"}>
            <article>
              <h3>Calculadora de horas trabajadas</h3>
              <p>Calcula el tiempo trabajado restando los descansos en una jornada diaria.</p>
            </article>
          </a>
        </li>
        <li>
          <a href={import.meta.env.BASE_URL + "calculadora-semanal-horas/"}>
            <article>
              <h3>Calculadora semanal de horas</h3>
              <p>Calcula el total de horas trabajadas en tu jornada completa (lunes a domingos).</p>
            </article>
          </a>
        </li>
        <li>
          <a href={import.meta.env.BASE_URL + "como-calcular-horas-trabajadas/"}>
            <article aria-labelledby="learn-extra-calculator-heading">
              <h3 id="learn-extra-calculator-heading">Cómo calcular las horas trabajadas</h3>
              <p>Aprende paso a paso cómo calcular tu tiempo laboral con ejemplos y casos de medianoche.</p>
            </article>
          </a>
        </li>
      </ul>
    </nav>
  </section>

  </main>
</BaseLayout>