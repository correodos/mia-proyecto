---
import HorasExtraCalculator from '../../components/calculator/HorasExtraCalculator.astro';

/** @type {import('astro').PageMetadata} */
export const metadata = {
  title: 'Calculadora de horas extra - Calcula tus horas extra',
  description: 'Calcula las horas trabajadas y las horas extra de tu jornada con esta calculadora online gratuita. Incluye descansos y jornadas que cruzan la medianoche.',
};

export const canonicalURL = '/calculadora-horas-extra/';
---

<html lang="es">
  <head>
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content="https://correodos.github.io/mia-proyecto/calculadora-horas-extra/" />
    <meta property="og:site_name" content="MiA - Herramientas de tiempo" />
    <meta property="og:locale" content="es_ES" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    
    <!-- Favicon -->
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
  </head>

  <body>
    <header role="banner">
      <nav role="navigation" aria-label="Principal">
        <a href={import.meta.env.BASE_URL} aria-label="Ir al inicio" class="header-link">MiA - Herramientas de tiempo</a>
      </nav>
    </header>

    <main role="main">
      <HorasExtraCalculator />
      
      <h1>Calculadora de horas extra</h1>
      
      <section class="description">
        Calcula las horas trabajadas por día y determina cuántas horas extra has realizado respecto a tu jornada laboral prevista.
        Esta calculadora gratuita permite:
        
        <ul>
          <li>Cruce de medianoche (jornadas de 22:00 a 06:00)</li>
          <li>Incluir descansos en la jornada</li>
          <li>Jornadas partidas o completas</li>
          <li>Resultado en horas decimales y formato Xh Ym</li>
        </ul>
      </section>

      <section class="usage">
        <h2>Cómo usarla</h2>
        
        <p>Introduce los datos de tu jornada:</p>
        
        <ol>
          <li><strong>Hora de entrada:</strong> A qué hora comienzas tu turno (ej: 08:00)</li>
          <li><strong>Hora de salida:</strong> A qué hora terminas tu turno (ej: 18:00)</li>
          <li><strong>Jornada prevista:</strong> Cuántas horas debes trabajar al día (ej: 08:00)</li>
          <li><strong>Descanso:</strong> Tiempo de pausa durante la jornada (ej: 01:00)</li>
        </ol>
        
        <p>Pulsa <kbd>Calcular</kbd> para ver tus horas trabajadas y horas extra.</p>
        
        <p>O usa el botón <kbd>Reiniciar</kbd> para limpiar los campos.</p>
      </section>

      <hr />

      <h3>Ejemplos</h3>
      
      <div class="examples">
        <details>
          <summary>Jornada normal sin horas extra</summary>
          <p><strong>Entrada:</strong> 08:00 | <strong>Salida:</strong> 16:00 | <strong>Descanso:</strong> 00:30 | <strong>Prevista:</strong> 08:00</p>
          <p><em>Trabajadas: 7:30 | Horas extra: 0 horas</em></p>
        </details>

        <details>
          <summary>Jornada con horas extra</summary>
          <p><strong>Entrada:</strong> 22:00 | <strong>Salida:</strong> 07:30 | <strong>Descanso:</strong> 01:00 | <strong>Prevista:</strong> 08:00</p>
          <p><em>Trabajadas: 9:30 | Horas extra: 1:30 (1.50 horas)</em></p>
        </details>

        <details>
          <summary>Jornada nocturna cruzando medianoche</summary>
          <p><strong>Entrada:</strong> 23:00 | <strong>Salida:</strong> 04:00 | <strong>Descanso:</strong> 00:45 | <strong>Prevista:</strong> 06:00</p>
          <p><em>Trabajadas: 4:15 | Horas extra: 0 horas (jornada inferior a la prevista)</em></p>
        </details>
      </div>

      <hr />

      <section class="faq">
        <h2>Preguntas frecuentes</h2>
        
        <div class="faq-item">
          <h3>¿La calculadora funciona si trabajo toda la noche?</h3>
          <p>Sí. Puedes introducir una entrada (ej: 22:00) y salida anterior (ej: 06:00), lo que indica que la jornada cruza la medianoche.</p>
        </div>

        <div class="faq-item">
          <h3>¿Puedo no poner descanso?</h3>
          <p>Sí. Puedes dejar el campo vacío o poner 00:00 si no has tenido pausa.</p>
        </div>

        <div class="faq-item">
          <h3>¿Qué significa "horas extra"?</h3>
          <p>Las horas extra son el tiempo trabajado que supera la jornada prevista. Si trabajaste 9 horas y tu jornada era de 8, tienes 1 hora extra.</p>
        </div>

        <div class="faq-item">
          <h3>¿Funciona en móvil?</h3>
          <p>Sí. Optimizada para ordenadores, tabletas y teléfonos móviles.</p>
        </div>
      </section>

      <a href={import.meta.env.BASE_URL}>← Volver al inicio</a>
      
      <hr />

      <a href="/calculadora-horas/">Calculadora de horas trabajadas</a> | 
      <a href="/calculadora-semanal-horas/">Calculadora semanal de horas</a>
    </main>

    <footer role="contentinfo">
      <p>Herramienta gratuita</p>
    </footer>
  </body>
</html>

<style lang="css">
:root {
  --primary: #3b82f6;
  --text: #1f2937;
  --bg: #ffffff;
}

html body {
  max-width: min(100% - 2rem, 800px);
  margin: 0 auto;
  font-family: system-ui, -apple-system, sans-serif;
  color: var(--text);
  background-color: var(--bg);
}

h1 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.description {
  margin: 1rem 0 1.5rem 0;
  line-height: 1.6;
}

ul, ol {
  padding-left: 1.5rem;
}

details {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

summary {
  cursor: pointer;
  padding: 0.5rem;
  font-weight: 600;
}

details[open] summary {
  margin-bottom: 0.5rem;
}

p, li {
  margin-bottom: 0.25rem;
}

h2, h3 {
  margin-top: 1.5rem;
}

hr {
  border: none;
  border-top: 1px solid #e5e7eb;
  margin: 2rem 0;
}

a {
  color: var(--primary);
}

kbd {
  background-color: #f3f4f6;
  padding: 0.125rem 0.375rem;
  border-radius: 4px;
  font-family: monospace;
  border: 1px solid #e5e7eb;
}

.examples {
  margin: 1rem 0;
}

.faq-item h3 {
  margin: 0 0 0.5rem 0;
}

@media (max-width: 600px) {
  html body {
    padding: 0.5rem;
  }

  h1 {
    font-size: 1.5rem;
  }
  
  .examples details {
    margin-bottom: 0.25rem;
  }
}
</style>

<link rel="canonical" href="/calculadora-horas-extra/">
<open-graph />

<title>{metadata.title}</title>
<meta name="description" content={metadata.description} />

<link rel="next" href="/calculadora-semanal-horas/" title="Calculadora semanal de horas" />
<link rel="prev" href="/calculadora-horas/" title="Calculadora de horas" />
