---
import DailyCalculator from '../../components/calculator/DailyCalculator.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollapsibleExamples from '../../components/CollapsibleExamples.astro';

const pageData = {
  title: "Calculadora de Horas Trabajadas",
  description: "Calculadora gratuita de horas trabajadas. Ingresa entrada, salida y descanso para obtener horas trabajadas y decimal.",
  canonical: "https://miaherramienta.com/calculadora-horas/"
};

const { title, description, canonical } = pageData;
---

<BaseLayout title={title} description={description} canonical={canonical}>
<main role="main">
  <h1>Calculadora de horas trabajadas</h1>
  
  <section class="intro-section">
    <p class="intro-text">
      Calcula tus horas trabajadas restando el descanso al tiempo entre entrada y salida. Soporta turnos nocturnos y muestra resultado en horas:minutos y decimal.
    </p>
  </section>
  
  <DailyCalculator />
  
  <section aria-labelledby="how-to-heading" class="content-section">
    <h2 id="how-to-heading">Cómo calcular las horas trabajadas</h2>
    
    <ol class="steps">
      <li>Introduce la hora de entrada (formato HH:MM).</li>
      <li>Indica la hora de salida y los minutos de descanso.</li>
      <li>Pulsa "Calcular" para obtener el resultado.</li>
    </ol>
  </section>

  <section aria-labelledby="examples-heading" class="content-section">
    <CollapsibleExamples
      title="Ejemplos de cálculo"
      examples={[
        {
          summary: 'Jornada diurna: 09:00 → 17:30, descanso 60 min',
          content: '<p><strong>Horas trabajadas:</strong> 7 horas y 30 minutos (7,50 horas)</p>',
        },
        {
          summary: 'Jornada nocturna (medianoche): 22:00 → 06:00, descanso 30 min',
          content: '<p><strong>Horas trabajadas:</strong> 7 horas y 30 minutos (7,50 horas)</p><p><small>La calculadora detecta automáticamente el cruce de medianoche.</small></p>',
        },
      ]}
    />
  </section>

  <section aria-labelledby="faq-heading" class="content-section">
    <CollapsibleExamples
      title="Preguntas frecuentes"
      examples={[
        {
          summary: '¿Cómo se calculan las horas trabajadas?',
          content: '<p>La calculadora resta la hora de entrada a la de salida y descuenta los minutos de descanso. El resultado aparece en horas:minutos, minutos totales y horas decimales.</p>',
        },
        {
          summary: '¿Puedo calcular una jornada que termina después de medianoche?',
          content: '<p>Sí. Introduce la hora inicial y final de tu turno (ej. 22:00 y 06:00). La calculadora detecta el cruce de medianoche automáticamente.</p>',
        },
        {
          summary: '¿Qué significa el resultado en horas decimales?',
          content: '<p>Es el tiempo total trabajado expresado como número decimal (ej. 7,50 h = 7 h 30 min). Útil para nóminas y facturación. No confundir con el formato horario "7:30".</p>',
        },
        {
          summary: '¿Qué son las horas decimales y los turnos nocturnos?',
          content: '<p><strong>Horas decimales:</strong> 7 h 30 min = 7,50 h. El decimal representa tiempo total, no un horario.<br><strong>Turnos nocturnos:</strong> Si tu jornada cruza medianoche (ej. 22:00 → 06:00), la calculadora lo detecta y calcula correctamente las horas.</p>',
        },
      ]}
    />
  </section>

  <section aria-labelledby="other-tools-heading" class="tools-list">
    <h2 id="other-tools-heading">Otras herramientas</h2>
    
    <nav role="navigation" aria-label="Otras herramientas">
      <ul role="list">
        <li>
          <a href={import.meta.env.BASE_URL + "calculadora-semanal-horas/"}>
            <article>
              <h3>Calculadora semanal de horas</h3>
              <p>Calcula el total de horas trabajadas en tu jornada completa (lunes a domingos).</p>
            </article>
          </a>
        </li>
        <li>
          <a href={import.meta.env.BASE_URL + "calculadora-jornada-partida/"}>
            <article>
              <h3>Calculadora de jornada partida</h3>
              <p>Para turnos divididos en dos tramos separados durante el día.</p>
            </article>
          </a>
        </li>
        <li>
          <a href={import.meta.env.BASE_URL + "como-calcular-horas-trabajadas/"}>
            <article aria-labelledby="learn-calculator-heading">
              <h3 id="learn-calculator-heading">Cómo calcular las horas trabajadas</h3>
              <p>Aprende paso a paso cómo calcular tu tiempo laboral con ejemplos y casos de medianoche.</p>
            </article>
          </a>
        </li>
      </ul>
    </nav>
  </section>

  <footer role="contentinfo">
    <p>Herramienta gratuita para calcular horas trabajadas</p>
  </footer>
</main>
</BaseLayout>